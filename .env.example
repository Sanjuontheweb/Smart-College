# ====================================================================
# SMART CAMPUS AI - MOBILE APP ENVIRONMENT CONFIGURATION
# ====================================================================

# 1. Supabase Project Credentials (from your Supabase Dashboard > Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# 2. Secure Server-Side AI Assistant Server URL
# When testing on Android phone via Expo Go on the same Wi-Fi network,
# set this to your computer's local IP address (e.g. http://192.168.1.15:5000)
# When testing on an Android emulator or locally on PC, use http://localhost:5000
EXPO_PUBLIC_AI_SERVER_URL=http://localhost:5000
